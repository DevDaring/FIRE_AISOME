# ============================================================================
# SECRETS — never commit. The .env in this project holds ~34 live API keys.
# ============================================================================
.env
.env.*
!.env.example
*.key
*.pem
credentials*
secrets*

# ============================================================================
# ORGANIZER-DISTRIBUTED DATA — do not redistribute.
# The Hindi/Bengali test files were emailed privately to registered teams.
# Publishing them would republish the organizers' evaluation set before the
# track has even closed. artifacts/test_*.csv are cleaned copies of the same
# comments, so they are excluded too.
# ============================================================================
Codes/Dataset/Testing_Data/
artifacts/test_*.csv
Codes/artifacts/test_*.csv

# ============================================================================
# PUBLIC TRAINING DATA — fetched by scripts/fetch_data.sh, not vendored.
# GWSD and SemEval-2016 each carry their own terms; link, don't copy.
# ============================================================================
Codes/Dataset/Training_Data/*.tsv
Codes/Dataset/Training_Data/*.txt

# ============================================================================
# Derived artifacts — regenerable, large, and full of cached model output
# ============================================================================
Codes/artifacts/
artifacts/
*.pt
*.bin
*.safetensors
*.joblib
*.ckpt
checkpoints/
wandb/

# ============================================================================
# Python
# ============================================================================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/

# ============================================================================
# OS / editor
# ============================================================================
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Run logs — can contain provider error text with live keys in it
logs/
Codes/logs/
*.log

# Large model checkpoints live on HuggingFace, not in git
Codes/artifacts/model_*/

# ============================================================================
# DOCS AND THE PAPER — kept locally, deliberately NOT published in this repo.
# The repo publishes code + results only; README.md at the root is the one doc.
# Submission/ holds the CEUR working note and its build; procedure.html and
# Required_Action.md are working notes; STRATEGY.md documents the test-set
# analysis; the LREC PDF is an unpublished manuscript.
# ============================================================================
Submission/
procedure.html
Required_Action.md
Codes/STRATEGY.md
Submitted_LREC_Zero_Shot_Multilingual_Extended.pdf
*.md
!README.md
